    { model: 'S-209', type: 'screw-pin', material: 'carbon', wll: 17, size: 1.5, pin: 39, weight: 5.00 },
  ];

  document.getElementById('shackle-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const load = parseFloat(document.getElementById('load-input').value);
    const type = document.getElementById('type-input').value;
    const material = document.getElementById('material-input').value;
    
    if (!load || load <= 0) return;
    
    // Filter shackles
    let filtered = SHACKLES;
    if (type) filtered = filtered.filter(s => s.type === type);
    if (material) filtered = filtered.filter(s => s.material === material);
    
    // Find smallest shackle with WLL >= load
    filtered.sort((a, b) => a.wll - b.wll);
    const shackle = filtered.find(s => s.wll >= load);
    
    if (!shackle) {
      alert('No shackle found for this load. Maximum WLL is 120 tonnes.');
      return;
    }
    
    // Display result
    document.getElementById('result-model').textContent = shackle.model;
    document.getElementById('result-wll').textContent = shackle.wll + ' t';
    document.getElementById('result-size').textContent = shackle.size + '"';
    document.getElementById('result-pin').textContent = shackle.pin + ' mm';
    document.getElementById('result-weight').textContent = shackle.weight + ' kg';
    
    const safetyFactor = shackle.wll / load;
    const warningEl = document.getElementById('result-warning');
    
    if (safetyFactor < 1.1) {
      warningEl.textContent = 'Load is very close to WLL. Consider next size up for safety margin.';
      warningEl.classList.remove('hidden');
    } else if (safetyFactor > 5) {
      warningEl.textContent = 'Shackle is significantly oversized. Consider smaller size for cost efficiency.';
      warningEl.classList.remove('hidden');
    } else {
      warningEl.classList.add('hidden');
    }
    
    document.getElementById('shackle-result').classList.remove('hidden');
    
    // Track event
    if (typeof gtag !== 'undefined') {
      gtag('event', 'tool_complete', {
        tool_name: 'shackle_size_calculator',
        result_value: shackle.wll
      });
    }
  });

  // RFQ form
  document.getElementById('rfq-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    if (typeof gtag !== 'undefined') {
      gtag('event', 'rfq_submit', {
        tool_name: 'homepage'
      });
    }
    
    this.innerHTML = '<div class="text-center py-8"><div class="text-4xl mb-4">✅</div><h4 class="text-xl font-bold text-white mb-2">RFQ Submitted</h4><p class="text-gray-400">We will contact you within 24 hours with quotes from vetted suppliers.</p></div>';

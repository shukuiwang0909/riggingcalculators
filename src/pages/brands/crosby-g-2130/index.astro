---
import BlogBase from "../../../layouts/BlogBase.astro";
import { CROSBY_SHACKLES } from "../../../data/shackles.ts";

const pubDate = "2026-09-18";

const FRACTIONS: Record<string, string> = {
  "0.25":   '1/4"',
  "0.3125": '5/16"',
  "0.375":  '3/8"',
  "0.4375": '7/16"',
  "0.5":    '1/2"',
  "0.625":  '5/8"',
  "0.75":   '3/4"',
  "0.875":  '7/8"',
  "1":      '1"',
  "1.125":  '1-1/8"',
  "1.25":   '1-1/4"',
  "1.375":  '1-3/8"',
  "1.5":    '1-1/2"',
  "1.75":   '1-3/4"',
  "2":      '2"',
  "2.5":    '2-1/2"',
  "3":      '3"',
  "3.5":    '3-1/2"',
  "4":      '4"',
};

function fmt(n: number): string {
  if (n >= 100) return n.toFixed(0);
  if (n >= 10)  return n.toFixed(1);
  return n.toFixed(2);
}

const g2130 = CROSBY_SHACKLES.filter(s => s.model === "G-2130");

const wllRows = g2130.map(s => {
  const pinIn  = FRACTIONS[String(s.size_inch)] ?? `${s.size_inch}"`;
  const pinMm  = `${Math.round(s.size_inch * 25.4)} mm`;
  const wllMt  = s.wll_tonnes;
  const wllUs  = wllMt * 1.1023;
  const blUs   = wllUs * 5;
  const blMt   = wllMt * 5;
  return [pinIn, pinMm, fmt(wllUs), fmt(wllMt), fmt(blUs), fmt(blMt)];
});

const faqItems = [
  {
    q: "What is the Crosby G-2130 shackle?",
    a: "The G-2130 is The Crosby Group's alloy steel bolt-type anchor (bow) shackle. The bolt, nut, and cotter pin provide positive pin retention — the pin cannot back out under vibration or rotation. It conforms to ASME B30.26 at 5:1 design factor.",
  },
  {
    q: "When must I use a bolt-type shackle instead of a screw pin?",
    a: "ASME B30.26 requires bolt-type shackles (not screw pin) for overhead crane service. Bolt-type is also required when the shackle will be subjected to rotation, vibration, or will be left in service for extended periods. When in doubt, use the G-2130.",
  },
  {
    q: "How do I install a Crosby G-2130?",
    a: "1. Insert the bolt through the jaw holes and the sling or load. 2. Thread the nut fully onto the bolt. 3. Align the cotter pin hole and insert the cotter pin. 4. Bend both legs of the cotter pin apart to lock. Never use the shackle without the cotter pin installed. Do not substitute a pin or bolt from another manufacturer.",
  },
  {
    q: 'What is the WLL of a G-2130 1" shackle?',
    a: 'The G-2130 in 1" pin size has a WLL of 8.5 metric tonnes (9.4 US tons), same as the G-209. The design factor is 5:1. Verify against the current Crosby catalog before use.',
  },
  {
    q: "Can I replace a G-2130 bolt with a standard hardware bolt?",
    a: "No. Never substitute. The Crosby G-2130 bolt is a precision-machined alloy component rated as part of the shackle assembly. Standard hardware bolts are not rated for lifting and will fail at loads well below the shackle WLL. Only use Crosby replacement parts.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: "Crosby G-2130 Bolt Type Anchor Shackle",
    description: "Crosby G-2130 alloy bolt-type anchor shackle reference: WLL from 0.5 to 120 metric tonnes, overhead crane service requirements, and comparison with screw-pin G-209.",
    brand: { "@type": "Brand", name: "Crosby" },
    manufacturer: { "@type": "Organization", name: "The Crosby Group" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
];
---
<BlogBase
  title="Crosby G-2130 Bolt Type Shackle: WLL Chart & ASME B30.26 Specs"
  description="Crosby G-2130 alloy bolt-type anchor shackle reference: WLL from 0.5 to 120 metric tonnes, overhead crane service requirements, and comparison with screw-pin G-209."
  canonical="/brands/crosby-g-2130/"
  ogType="article"
  pubDate={pubDate}
  jsonLd={jsonLd}
  breadcrumbItems={[
    { name: "Home", url: "/" },
    { name: "Brands", url: "/brands/" },
    { name: "Crosby G-2130", url: "/brands/crosby-g-2130/" },
  ]}
>
  <div class="max-w-3xl mx-auto px-4 py-10">
    <div class="flex flex-wrap gap-2 mb-4">
      <span class="text-xs px-2 py-0.5 rounded-full" style="background:#1e2030; color:#94a3b8; border:1px solid #2a2d3e;">Brand Reference</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">Crosby</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">Shackles</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">ASME B30.26</span>
    </div>

    <h1 class="text-3xl md:text-4xl font-bold text-white mb-3 leading-tight">Crosby G-2130 Bolt Type Shackle: WLL Chart & ASME B30.26 Specs</h1>
    <p class="text-gray-400 text-lg mb-8 leading-relaxed">The G-2130 is The Crosby Group's alloy steel bolt-type anchor (bow) shackle. Its bolt, nut, and cotter pin provide positive pin retention — required by ASME B30.26 for overhead crane service and recommended wherever vibration or rotation is present.</p>

    <div class="answer-box mb-8">
      <p><strong>Quick reference:</strong> The G-2130 is the positively-locked version of Crosby's alloy anchor shackle. Use it instead of the G-209 wherever ASME B30.26 requires a bolt-type pin: overhead crane service, vibrating equipment, sustained rigging configurations, and any application where the pin may rotate. WLL and size range are the same as the G-209.</p>
    </div>

    <div class="prose-rc">

      <h2>Crosby G-2130 WLL Size Chart</h2>
      <p>All values derived from The Crosby Group catalog data. WLL in US short tons and metric tonnes. Design factor 5:1 per ASME B30.26.</p>

      <table>
        <thead>
          <tr>
            <th>Pin Dia (in)</th>
            <th>Pin Dia (mm)</th>
            <th>WLL (US tons)</th>
            <th>WLL (metric t)</th>
            <th>Break Load (US tons)</th>
            <th>Break Load (t)</th>
          </tr>
        </thead>
        <tbody>
          {wllRows.map(([pin_in, pin_mm, wll_us, wll_mt, bl_us, bl_mt]) => (
            <tr>
              <td style="font-family:'JetBrains Mono',monospace; color:#f59e0b; font-weight:600;">{pin_in}</td>
              <td style="color:#64748b;">{pin_mm}</td>
              <td style="font-weight:600;">{wll_us}</td>
              <td>{wll_mt}</td>
              <td style="color:#64748b;">{bl_us}</td>
              <td style="color:#64748b;">{bl_mt}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p style="font-size:0.75rem; color:#475569;">Reference data only. Verify current ratings against The Crosby Group official catalog before use in safety-critical applications.</p>

      <h2>G-2130 Key Specifications</h2>
      <table>
        <thead><tr><th>Property</th><th>Value</th></tr></thead>
        <tbody>
          <tr><td>Type</td><td>Bolt-type anchor (bow) shackle</td></tr>
          <tr><td>Material</td><td>Alloy steel, quenched &amp; tempered</td></tr>
          <tr><td>Finish</td><td>Yellow chromate</td></tr>
          <tr><td>Design factor</td><td>5:1 (ASME B30.26)</td></tr>
          <tr><td>Standards</td><td>ASME B30.26, Federal Spec RR-C-271</td></tr>
          <tr><td>Pin type</td><td>Bolt + nut + cotter pin — positive lock</td></tr>
        </tbody>
      </table>

      <h2>When Bolt Type Is Required by ASME B30.26</h2>
      <p>ASME B30.26 explicitly requires bolt-type shackles for overhead crane service. Screw-pin shackles, including the G-209, may unscrew under sustained vibration, repetitive loading, or when the shackle rotates relative to its load. The G-2130 eliminates this risk: the cotter pin locks the nut, and the nut locks the bolt — the assembly cannot loosen without deliberate disassembly.</p>
      <p>Use the G-2130 in any of these conditions:</p>
      <ul>
        <li>Overhead crane lifting (required by ASME B30.26)</li>
        <li>Any environment with mechanical vibration</li>
        <li>Long-duration or semi-permanent rigging configurations</li>
        <li>Applications where the shackle may rotate relative to the sling or load attachment</li>
        <li>Marine and offshore rigging where wave action creates dynamic loading</li>
      </ul>

      <h2>G-2130 Installation Steps</h2>
      <ol style="list-style:decimal; padding-left:1.5rem; color:#94a3b8; line-height:1.75; margin-bottom:1rem;">
        <li style="margin-bottom:0.5rem;">Insert the bolt through the jaw holes and the sling eye or load attachment.</li>
        <li style="margin-bottom:0.5rem;">Thread the nut fully onto the bolt — hand-tighten until snug.</li>
        <li style="margin-bottom:0.5rem;">Align the cotter pin hole in the bolt with the slot in the nut.</li>
        <li style="margin-bottom:0.5rem;">Insert the cotter pin through the hole.</li>
        <li style="margin-bottom:0.5rem;">Bend both legs of the cotter pin apart (180°) to lock — never reuse a bent cotter pin.</li>
        <li>Inspect the assembly before each lift: confirm the cotter pin is fully seated and bent.</li>
      </ol>

    </div>

    <div class="cta-box my-8">
      <p class="text-white font-bold text-base mb-2">Verify your Crosby G-2130 selection with our calculator</p>
      <p class="text-gray-400 text-sm mb-4">Enter your load weight, sling angle, and number of legs to get the minimum required shackle WLL — then cross-reference the G-2130 size chart above.</p>
      <div class="flex flex-wrap gap-3">
        <a href="/shackle-size-calculator" class="accent-btn">Shackle Size Calculator</a>
        <a href="/sling-angle-calculator" style="background:#1e2030; color:#f1f5f9; font-weight:600; padding:0.5rem 1.25rem; border-radius:0.5rem; text-decoration:none; border:1px solid #2a2d3e; display:inline-block;">Sling Angle Calculator</a>
      </div>
    </div>

    <div class="prose-rc">
      <h2>Frequently Asked Questions</h2>
      {faqItems.map(({ q, a }) => (
        <details style="border:1px solid #1e2030; border-radius:0.5rem; padding:0.75rem 1rem; margin-bottom:0.75rem; cursor:pointer;">
          <summary style="font-weight:600; color:#f1f5f9; list-style:none;">{q}</summary>
          <p style="margin-top:0.5rem; font-size:0.9rem;">{a}</p>
        </details>
      ))}
    </div>

    <div class="mt-10 pt-8" style="border-top:1px solid #1e2030;">
      <p class="text-gray-500 text-sm font-semibold mb-3">Other brand references</p>
      <div class="grid sm:grid-cols-3 gap-3 text-sm">
        <a href="/brands/crosby-g-209/" class="cta-box block hover:border-amber-500/40 transition-colors" style="padding:1rem; margin:0;">
          <p class="text-white font-semibold">Crosby G-209</p>
          <p class="text-gray-500 text-xs mt-0.5">Alloy screw-pin anchor shackle</p>
        </a>
        <a href="/brands/crosby-g-2150/" class="cta-box block hover:border-amber-500/40 transition-colors" style="padding:1rem; margin:0;">
          <p class="text-white font-semibold">Crosby G-2150</p>
          <p class="text-gray-500 text-xs mt-0.5">Alloy screw-pin chain shackle</p>
        </a>
        <a href="/blog/rigging-inspection-checklist/" class="cta-box block hover:border-amber-500/40 transition-colors" style="padding:1rem; margin:0;">
          <p class="text-white font-semibold">Rigging Inspection Guide</p>
          <p class="text-gray-500 text-xs mt-0.5">ASME B30.9 rejection criteria</p>
        </a>
      </div>
    </div>

    <p class="mt-8 text-xs text-gray-600">Disclaimer: This page is an independent engineering reference. RiggingCalculators.com is not affiliated with The Crosby Group. Always verify specifications against the manufacturer's current catalog before use.</p>
  </div>
</BlogBase>

---
import BlogBase from "../../../layouts/BlogBase.astro";

const faqItems = [
  {
    q: "What shackle lines does Columbus McKinnon (CM) make?",
    a: "Columbus McKinnon manufactures shackles under the CM brand. Their range includes the CM #488 screw-pin anchor shackle and #489 bolt-type anchor shackle (bow shackles) from 1/4\" to 2\" (WLL 1/2 to 35 tons), plus specialty and alloy versions. CM is now part of the Columbus McKinnon Corporation which also owns Yale, Coffing, and Chester hoists.",
  },
  {
    q: "What is the WLL of a CM 1\" anchor shackle?",
    a: "The CM 1\" (#488 or #489) carbon steel anchor shackle has a WLL of 8-1/2 US tons (7.7 metric tonnes) — same as the Crosby G-2150 at that pin diameter. All ASME B30.26 compliant shackles of the same size carry the same WLL, regardless of brand, because the standard specifies minimum performance.",
  },
  {
    q: "Are CM shackles ASME B30.26 compliant?",
    a: "Yes. CM shackles sold in the US are manufactured to ASME B30.26 with a 5:1 design factor. They are embossed with WLL in US tons and include heat traceability codes for full material traceability.",
  },
  {
    q: "Is Columbus McKinnon the same as CM?",
    a: "Yes. CM is the brand name; Columbus McKinnon Corporation (CMCO) is the parent company. CMCO also owns the Yale, Coffing, Shaw-Box, and Chester brands. CM shackles and hoists are sold under the CM brand but manufactured and supported by Columbus McKinnon.",
  },
  {
    q: "Can I use a CM shackle on an overhead crane?",
    a: "Yes, with the bolt-type pin (CM #489 or equivalent). For overhead crane service, ASME B30.26 requires positively-locked pin — either bolt/nut/cotter or a keeper pin system. The screw-pin #488 should be moused for overhead use. Verify the shackle is rated for the maximum pick weight plus dynamic load allowance.",
  },
  {
    q: "How do I identify a genuine CM shackle?",
    a: "Genuine CM shackles carry: the CM brand stamp on the body, WLL in tons, pin size or part number, and a heat code for traceability. The body and pin should show no casting marks — CM shackles are drop-forged, not cast. Any shackle without a visible, legible WLL marking must be removed from service.",
  },
];

const wllRows = [
  ["1/4\"", "#488/489", "1/2", "0.23", "2.50"],
  ["5/16\"", "#488/489", "3/4", "0.34", "3.75"],
  ["3/8\"", "#488/489", "1", "0.45", "5.0"],
  ["7/16\"", "#488/489", "1-1/2", "0.68", "7.5"],
  ["1/2\"", "#488/489", "2", "0.90", "10.0"],
  ["5/8\"", "#488/489", "3-1/4", "1.50", "16.3"],
  ["3/4\"", "#488/489", "4-3/4", "2.16", "23.8"],
  ["7/8\"", "#488/489", "6-1/2", "2.95", "32.5"],
  ["1\"", "#488/489", "8-1/2", "3.86", "42.5"],
  ["1-1/4\"", "#488/489", "13-1/2", "6.12", "67.5"],
  ["1-1/2\"", "#488/489", "17", "7.71", "85.0"],
  ["2\"", "#488/489", "35", "15.9", "175"],
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: "CM Screw-Pin Anchor Shackle #488",
    description: "Forged carbon steel ASME B30.26 bow shackle by Columbus McKinnon. WLL 1/2 to 35 tons at 5:1 design factor.",
    brand: { "@type": "Brand", name: "CM / Columbus McKinnon" },
    manufacturer: { "@type": "Organization", name: "Columbus McKinnon Corporation" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
];
---
<BlogBase
  title="CM Shackles (Columbus McKinnon) — WLL Chart, #488 Specs & Selection"
  description="CM Columbus McKinnon shackle specs: WLL 1/2 to 35 tons for #488 screw-pin and #489 bolt-type anchor shackles, ASME B30.26, 5:1 design factor."
  canonical="/brands/cm-shackles/"
  jsonLd={jsonLd}
  breadcrumbItems={[
    { name: "Home", url: "/" },
    { name: "Brands", url: "/brands/" },
    { name: "CM / Columbus McKinnon Shackles", url: "/brands/cm-shackles/" },
  ]}
>
  <div class="max-w-3xl mx-auto px-4 py-10">
    <div class="flex flex-wrap gap-2 mb-4">
      <span class="text-xs px-2 py-0.5 rounded-full" style="background:#1e2030; color:#94a3b8; border:1px solid #2a2d3e;">Brand Reference</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">Columbus McKinnon</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">Shackles</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">ASME B30.26</span>
    </div>

    <h1 class="text-3xl md:text-4xl font-bold text-white mb-3 leading-tight">CM Shackles (Columbus McKinnon) — WLL Chart, #488 Specs & Selection</h1>
    <p class="text-gray-400 text-lg mb-8 leading-relaxed">Columbus McKinnon's CM-brand shackles are a standard reference in North American industrial lifting. The #488 (screw-pin) and #489 (bolt-type) anchor shackles cover WLL from 1/2 to 35 US tons at the ASME B30.26 5:1 design factor.</p>

    <div class="prose-rc">

      <h2>CM #488 / #489 Anchor Shackle WLL Chart</h2>
      <p>Forged carbon steel bow shackles. ASME B30.26 compliant. WLL in US short tons and metric tonnes. #488 = screw pin; #489 = bolt-type with nut and cotter pin.</p>

      <table>
        <thead>
          <tr>
            <th>Pin Diameter</th>
            <th>Part #</th>
            <th>WLL (US tons)</th>
            <th>WLL (metric t)</th>
            <th>Break Load (US tons)</th>
          </tr>
        </thead>
        <tbody>
          {wllRows.map(([pin, part, wll_us, wll_mt, bl]) => (
            <tr>
              <td style="font-family:'JetBrains Mono',monospace; color:#f59e0b; font-weight:600;">{pin}</td>
              <td style="color:#64748b; font-size:0.85rem;">{part}</td>
              <td style="font-weight:600;">{wll_us}</td>
              <td>{wll_mt}</td>
              <td style="color:#64748b;">{bl}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p style="font-size:0.75rem; color:#475569;">Reference only. Verify against Columbus McKinnon official catalog. Design factor 5:1 per ASME B30.26.</p>

      <h2>#488 vs #489: Screw Pin vs Bolt Type</h2>
      <table>
        <thead><tr><th>Feature</th><th>#488 (Screw Pin)</th><th>#489 (Bolt Type)</th></tr></thead>
        <tbody>
          <tr><td>Pin locking</td><td>Threaded — requires mousing in vibration</td><td>Nut + cotter — positive lock</td></tr>
          <tr><td>Overhead crane service</td><td>Requires mousing per ASME B30.26</td><td>Preferred / required</td></tr>
          <tr><td>Rig/de-rig speed</td><td>Faster</td><td>Slower (nut + cotter)</td></tr>
          <tr><td>WLL range</td><td>1/2 – 35 tons</td><td>1/2 – 35 tons</td></tr>
          <tr><td>Price</td><td>Lower</td><td>Slightly higher</td></tr>
        </tbody>
      </table>

      <h2>How CM Shackles Compare to Crosby and Gunnebo</h2>
      <p>ASME B30.26 specifies the <em>minimum</em> performance for a given WLL — so all compliant 1" anchor shackles (CM, Crosby, Gunnebo) have the same WLL of 8-1/2 tons. The differences are in:</p>
      <ul>
        <li><strong>Manufacturing tolerances and finish quality</strong> — premium brands tend to tighter tolerances</li>
        <li><strong>Traceability</strong> — Crosby and CM both provide heat codes; verify with your QC requirements</li>
        <li><strong>Availability and distribution</strong> — CM is dominant in North America; Gunnebo in Europe</li>
        <li><strong>Special applications</strong> — for ATEX, subsea, or high-cycle applications, verify specific product lines</li>
      </ul>

      <h2>Frequently Asked Questions</h2>
      {faqItems.map(({ q, a }) => (
        <details style="border:1px solid #1e2030; border-radius:0.5rem; padding:0.75rem 1rem; margin-bottom:0.75rem; cursor:pointer;">
          <summary style="font-weight:600; color:#f1f5f9; list-style:none;">{q}</summary>
          <p style="margin-top:0.5rem; font-size:0.9rem;">{a}</p>
        </details>
      ))}

    </div>

    <div class="cta-box my-8">
      <p class="text-white font-bold text-base mb-2">Calculate required shackle WLL for your lift</p>
      <p class="text-gray-400 text-sm mb-4">Enter load, sling angle, and number of legs — get minimum WLL instantly. Cross-reference with the CM chart above.</p>
      <a href="/shackle-size-calculator" class="accent-btn">Shackle Size Calculator</a>
    </div>

    <div class="mt-10 pt-8" style="border-top:1px solid #1e2030;">
      <p class="text-gray-500 text-sm font-semibold mb-3">Other brand references</p>
      <div class="grid sm:grid-cols-3 gap-3 text-sm">
        <a href="/brands/crosby-g-2150/" class="cta-box block hover:border-amber-500/40 transition-colors" style="padding:1rem; margin:0;">
          <p class="text-white font-semibold">Crosby G-2150</p>
          <p class="text-gray-500 text-xs mt-0.5">Industry-standard bow shackle</p>
        </a>
        <a href="/brands/gunnebo/" class="cta-box block hover:border-amber-500/40 transition-colors" style="padding:1rem; margin:0;">
          <p class="text-white font-semibold">Gunnebo Viking & Titan</p>
          <p class="text-gray-500 text-xs mt-0.5">EN 13889 certified shackles</p>
        </a>
        <a href="/brands/yoke-lifting-points/" class="cta-box block hover:border-amber-500/40 transition-colors" style="padding:1rem; margin:0;">
          <p class="text-white font-semibold">YOKE Lifting Points</p>
          <p class="text-gray-500 text-xs mt-0.5">Swivel eye bolt WLL ratings</p>
        </a>
      </div>
    </div>

    <p class="mt-8 text-xs text-gray-600">Disclaimer: Independent engineering reference. RiggingCalculators.com is not affiliated with Columbus McKinnon Corporation. Verify against manufacturer's current catalog before use.</p>
  </div>
</BlogBase>

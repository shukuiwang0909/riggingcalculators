---
import BlogBase from "../../../layouts/BlogBase.astro";
import { CROSBY_SHACKLES } from "../../../data/shackles.ts";

const pubDate = "2026-09-22";

const FRACTIONS: Record<string, string> = {
  "0.25":   '1/4"',
  "0.3125": '5/16"',
  "0.375":  '3/8"',
  "0.4375": '7/16"',
  "0.5":    '1/2"',
  "0.625":  '5/8"',
  "0.75":   '3/4"',
  "0.875":  '7/8"',
  "1":      '1"',
  "1.125":  '1-1/8"',
  "1.25":   '1-1/4"',
  "1.375":  '1-3/8"',
  "1.5":    '1-1/2"',
  "1.75":   '1-3/4"',
  "2":      '2"',
  "2.5":    '2-1/2"',
  "3":      '3"',
  "3.5":    '3-1/2"',
  "4":      '4"',
};

function fmt(n: number): string {
  if (n >= 100) return n.toFixed(0);
  if (n >= 10)  return n.toFixed(1);
  return n.toFixed(2);
}

const s209 = CROSBY_SHACKLES.filter(s => s.model === "S-209");

const wllRows = s209.map(s => {
  const pinIn  = FRACTIONS[String(s.size_inch)] ?? `${s.size_inch}"`;
  const pinMm  = `${Math.round(s.size_inch * 25.4)} mm`;
  const wllMt  = s.wll_tonnes;
  const wllUs  = wllMt * 1.1023;
  const blUs   = wllUs * 5;
  const blMt   = wllMt * 5;
  return [pinIn, pinMm, fmt(wllUs), fmt(wllMt), fmt(blUs), fmt(blMt)];
});

const faqItems = [
  {
    q: "What is the Crosby S-209 shackle?",
    a: "The S-209 is The Crosby Group's carbon steel screw-pin anchor (bow) shackle. It conforms to ASME B30.26. The S-series uses carbon steel rather than the alloy steel of the G-series (G-209). Verify the current Crosby catalog for exact WLL values — alloy and carbon steel shackles of the same nominal size may have different ratings.",
  },
  {
    q: "What is the difference between G-209 and S-209?",
    a: "The G-209 is alloy steel (identified by its orange pin); the S-209 is carbon steel. Both are ASME B30.26 rated. For the same nominal size, alloy steel (G-209) typically delivers higher strength-to-weight ratio. The S-209 is generally used in applications where the alloy G-209 rating exceeds the requirement and cost is a factor.",
  },
  {
    q: "Can I interchange G-209 and S-209 shackles?",
    a: "Not without verifying WLL ratings. Do not assume a carbon steel S-209 and an alloy G-209 of the same nominal size have identical WLL. Always check the WLL stamped on the shackle body and cross-reference with the Crosby catalog.",
  },
  {
    q: "Does the S-209 require mousing?",
    a: "Yes — same as any screw-pin shackle. For vibrating, rotating, or overhead applications, thread a wire through the pin hole to prevent the pin backing out. For positive pin retention, use a bolt-type shackle (G-2130 or S-2130) instead.",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: "Crosby S-209 Carbon Steel Screw Pin Anchor Shackle",
    description: "Crosby S-209 carbon steel screw-pin anchor shackle reference: WLL chart, comparison with alloy G-209, and when to choose carbon steel for your rigging application.",
    brand: { "@type": "Brand", name: "Crosby" },
    manufacturer: { "@type": "Organization", name: "The Crosby Group" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
];
---
<BlogBase
  title="Crosby S-209 Shackle: WLL Chart & Carbon Steel Specs"
  description="Crosby S-209 carbon steel screw-pin anchor shackle reference: WLL chart, comparison with alloy G-209, and when to choose carbon steel for your rigging application."
  canonical="/brands/crosby-s-209/"
  ogType="article"
  pubDate={pubDate}
  jsonLd={jsonLd}
  breadcrumbItems={[
    { name: "Home", url: "/" },
    { name: "Brands", url: "/brands/" },
    { name: "Crosby S-209", url: "/brands/crosby-s-209/" },
  ]}
>
  <div class="max-w-3xl mx-auto px-4 py-10">
    <div class="flex flex-wrap gap-2 mb-4">
      <span class="text-xs px-2 py-0.5 rounded-full" style="background:#1e2030; color:#94a3b8; border:1px solid #2a2d3e;">Brand Reference</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">Crosby</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">Shackles</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">ASME B30.26</span>
    </div>

    <h1 class="text-3xl md:text-4xl font-bold text-white mb-3 leading-tight">Crosby S-209 Shackle: WLL Chart & Carbon Steel Specs</h1>
    <p class="text-gray-400 text-lg mb-8 leading-relaxed">The S-209 is The Crosby Group's carbon steel screw-pin anchor (bow) shackle. The S-series complements the alloy G-series with a carbon steel option conforming to ASME B30.26.</p>

    <div class="answer-box mb-8">
      <p><strong>Quick reference:</strong> The S-209 is Crosby's carbon steel screw-pin anchor shackle — the lower-cost complement to the alloy G-209. Both conform to ASME B30.26 at 5:1 design factor. Choose S-209 when the application is non-demanding and budget matters; choose G-209 when strength-to-weight or corrosion resistance is a concern. The S-209 is only available in smaller sizes (up to ~1-1/2").</p>
    </div>

    <div class="prose-rc">

      <h2>Crosby S-209 WLL Size Chart</h2>
      <p>All values derived from The Crosby Group catalog data. WLL in US short tons and metric tonnes. Design factor 5:1 per ASME B30.26.</p>

      <table>
        <thead>
          <tr>
            <th>Pin Dia (in)</th>
            <th>Pin Dia (mm)</th>
            <th>WLL (US tons)</th>
            <th>WLL (metric t)</th>
            <th>Break Load (US tons)</th>
            <th>Break Load (t)</th>
          </tr>
        </thead>
        <tbody>
          {wllRows.map(([pin_in, pin_mm, wll_us, wll_mt, bl_us, bl_mt]) => (
            <tr>
              <td style="font-family:'JetBrains Mono',monospace; color:#f59e0b; font-weight:600;">{pin_in}</td>
              <td style="color:#64748b;">{pin_mm}</td>
              <td style="font-weight:600;">{wll_us}</td>
              <td>{wll_mt}</td>
              <td style="color:#64748b;">{bl_us}</td>
              <td style="color:#64748b;">{bl_mt}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p style="font-size:0.75rem; color:#475569; border-left:3px solid #f59e0b; padding:0.5rem 0.75rem; background:#0f1117; border-radius:0 0.25rem 0.25rem 0;">
        <strong style="color:#f1f5f9;">Important:</strong> WLL values shown are from the data file. Always verify against the current Crosby Group catalog — carbon and alloy shackles of the same nominal size may have different WLL ratings.
      </p>

      <h2>S-209 Key Specifications</h2>
      <table>
        <thead><tr><th>Property</th><th>Value</th></tr></thead>
        <tbody>
          <tr><td>Type</td><td>Screw-pin anchor (bow) shackle</td></tr>
          <tr><td>Material</td><td>Carbon steel</td></tr>
          <tr><td>Finish</td><td>Yellow chromate</td></tr>
          <tr><td>Design factor</td><td>5:1 (ASME B30.26)</td></tr>
          <tr><td>Standards</td><td>ASME B30.26, Federal Spec RR-C-271</td></tr>
          <tr><td>Pin type</td><td>Threaded screw pin — for positive locking, use S-2130 or G-2130</td></tr>
        </tbody>
      </table>

      <h2>G-209 vs S-209: Alloy vs Carbon Steel</h2>
      <table>
        <thead><tr><th>Feature</th><th>G-209 (Alloy)</th><th>S-209 (Carbon Steel)</th></tr></thead>
        <tbody>
          <tr><td>Material</td><td>Alloy steel</td><td>Carbon steel</td></tr>
          <tr><td>Design factor</td><td>5:1 (ASME B30.26)</td><td>5:1 (ASME B30.26)</td></tr>
          <tr><td>Orange pin indicator</td><td>Yes — orange pin</td><td>No orange pin</td></tr>
          <tr><td>Typical applications</td><td>Industrial rigging, heavy &amp; demanding service</td><td>General purpose, lower-load or cost-sensitive applications</td></tr>
          <tr><td>Size range</td><td>1/4" – 4" (data file)</td><td>1/4" – 1-1/2" (data file)</td></tr>
        </tbody>
      </table>

    </div>

    <div class="cta-box my-8">
      <p class="text-white font-bold text-base mb-2">Verify your shackle selection with our calculator</p>
      <p class="text-gray-400 text-sm mb-4">Enter your load weight, sling angle, and number of legs to get the minimum required shackle WLL — then cross-reference the S-209 size chart above.</p>
      <div class="flex flex-wrap gap-3">
        <a href="/shackle-size-calculator" class="accent-btn">Shackle Size Calculator</a>
        <a href="/sling-angle-calculator" style="background:#1e2030; color:#f1f5f9; font-weight:600; padding:0.5rem 1.25rem; border-radius:0.5rem; text-decoration:none; border:1px solid #2a2d3e; display:inline-block;">Sling Angle Calculator</a>
      </div>
    </div>

    <div class="prose-rc">
      <h2>Frequently Asked Questions</h2>
      {faqItems.map(({ q, a }) => (
        <details style="border:1px solid #1e2030; border-radius:0.5rem; padding:0.75rem 1rem; margin-bottom:0.75rem; cursor:pointer;">
          <summary style="font-weight:600; color:#f1f5f9; list-style:none;">{q}</summary>
          <p style="margin-top:0.5rem; font-size:0.9rem;">{a}</p>
        </details>
      ))}
    </div>

    <div class="mt-10 pt-8" style="border-top:1px solid #1e2030;">
      <p class="text-gray-500 text-sm font-semibold mb-3">Other brand references</p>
      <div class="grid sm:grid-cols-3 gap-3 text-sm">
        <a href="/brands/crosby-g-209/" class="cta-box block hover:border-amber-500/40 transition-colors" style="padding:1rem; margin:0;">
          <p class="text-white font-semibold">Crosby G-209</p>
          <p class="text-gray-500 text-xs mt-0.5">Alloy screw-pin anchor shackle</p>
        </a>
        <a href="/brands/crosby-g-2130/" class="cta-box block hover:border-amber-500/40 transition-colors" style="padding:1rem; margin:0;">
          <p class="text-white font-semibold">Crosby G-2130</p>
          <p class="text-gray-500 text-xs mt-0.5">Alloy bolt-type anchor shackle</p>
        </a>
        <a href="/brands/crosby-g-2150/" class="cta-box block hover:border-amber-500/40 transition-colors" style="padding:1rem; margin:0;">
          <p class="text-white font-semibold">Crosby G-2150</p>
          <p class="text-gray-500 text-xs mt-0.5">Alloy screw-pin chain shackle</p>
        </a>
      </div>
    </div>

    <p class="mt-8 text-xs text-gray-600">Disclaimer: This page is an independent engineering reference. RiggingCalculators.com is not affiliated with The Crosby Group. Always verify specifications against the manufacturer's current catalog before use.</p>
  </div>
</BlogBase>

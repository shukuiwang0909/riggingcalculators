---
import BlogBase from "../../../layouts/BlogBase.astro";

const faqItems = [
  {
    q: "What is a YOKE lifting point?",
    a: "YOKE is a Taiwanese manufacturer of swivel and rotating lifting points. A YOKE lifting point (also called a swivel eye bolt or hoist ring) threads into a tapped hole in the load and can swivel 360° and tilt ±90°, allowing the sling to approach from any direction without losing its rated WLL. This eliminates the angular load penalty that would apply to a standard eye bolt.",
  },
  {
    q: "What is the WLL of a YOKE swivel lifting point?",
    a: "YOKE lifting points are rated by thread size. Common ratings: M12 = 1.5 t, M16 = 2 t, M20 = 3.15 t, M24 = 5 t, M30 = 8 t, M36 = 12.5 t, M48 = 22.4 t. These are 360°/90° swivel ratings — the WLL does not decrease with angle. Verify against YOKE's current catalog for your specific model.",
  },
  {
    q: "How does a YOKE swivel lifting point differ from a standard DIN 580 eye bolt?",
    a: "A standard DIN 580 eye bolt has an axial WLL (in-line with the bolt axis) that drops significantly at angles — at 90° from axial, DIN 580 WLL is reduced by 50–70%. A YOKE swivel lifting point maintains its full WLL at any sling angle because the swivel head rotates to align with the load vector. For any angular lift, use a swivel lifting point, not a fixed eye bolt.",
  },
  {
    q: "What thread standard do YOKE lifting points use?",
    a: "YOKE lifting points are available in metric coarse thread (M8 through M100) as standard. UNC (unified national coarse) inch thread versions are available for North American applications. Always verify thread pitch and engagement length — insufficient thread engagement reduces the pull-out strength below the WLL.",
  },
  {
    q: "How many threads must engage for a YOKE lifting point to reach full WLL?",
    a: "YOKE specifies a minimum thread engagement of 1× the bolt diameter (1d) for steel, and 1.5d for aluminum or soft metals. For example, an M20 bolt (20 mm diameter) requires at least 20 mm of thread engagement in steel to reach the rated 3.15 t WLL. Shallow tapped holes will fail at lower loads — verify the thread engagement depth in the load.",
  },
  {
    q: "Are YOKE lifting points certified to any standards?",
    a: "Yes. YOKE International manufactures lifting points to EN 1677-5 (Swivel lifting rings), EN 1677-1 (Grade 8 alloy steel), and ASME B30.26. Products are CE marked for European markets. YOKE maintains ISO 9001:2015 quality certification at their Taiwanese manufacturing facility.",
  },
  {
    q: "Can YOKE lifting points be used in overhead crane service?",
    a: "Yes — swivel lifting points are specifically designed for overhead crane use. They are a safer alternative to fixed eye bolts for any lift where the sling angle changes during the lift or where the crane hook is not directly above the load center. Verify the correct thread size and ensure proper engagement before use.",
  },
  {
    q: "What is the difference between YOKE Model 8-701 and 8-711?",
    a: "The YOKE 8-701 is a swivel (rotating) eye nut — it has an internal thread, used when you can thread the bolt through the load. The YOKE 8-711 is a swivel bolt — it has an external thread that screws into a tapped hole in the load. Both swivel 360°/tilt ±90° at full WLL. Choose based on whether you have a through-hole (nut) or tapped blind hole (bolt) in the load.",
  },
];

const wllRows = [
  ["M8", "0.25 t", "0.25", "2.5", "EN 1677-5"],
  ["M10", "0.5 t", "0.50", "5.0", "EN 1677-5"],
  ["M12", "1.5 t", "1.50", "7.5", "EN 1677-5"],
  ["M16", "2.0 t", "2.00", "10.0", "EN 1677-5"],
  ["M20", "3.15 t", "3.15", "15.75", "EN 1677-5"],
  ["M24", "5.0 t", "5.00", "25.0", "EN 1677-5"],
  ["M30", "8.0 t", "8.00", "40.0", "EN 1677-5"],
  ["M36", "12.5 t", "12.50", "62.5", "EN 1677-5"],
  ["M42", "16.0 t", "16.0", "80.0", "EN 1677-5"],
  ["M48", "22.4 t", "22.4", "112", "EN 1677-5"],
  ["M64", "40.0 t", "40.0", "200", "EN 1677-5"],
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: "YOKE Swivel Lifting Point",
    description: "360°/±90° swivel forged alloy steel lifting point by YOKE International. WLL 0.25 t to 40+ t at 4:1 design factor. EN 1677-5 / EN 1677-1 / CE marked.",
    brand: { "@type": "Brand", name: "YOKE" },
    manufacturer: { "@type": "Organization", name: "YOKE International" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
];
---
<BlogBase
  title="YOKE Lifting Points: Swivel Eye Bolt WLL Chart, Specs & Thread Guide"
  description="YOKE swivel lifting point WLL from M8 to M64, 360°/±90° rotation at full WLL, EN 1677-5 / ASME B30.26. Includes thread engagement requirements and comparison with DIN 580 eye bolts."
  canonical="/brands/yoke-lifting-points/"
  jsonLd={jsonLd}
  breadcrumbItems={[
    { name: "Home", url: "/" },
    { name: "Brands", url: "/brands/" },
    { name: "YOKE Lifting Points", url: "/brands/yoke-lifting-points/" },
  ]}
>
  <div class="max-w-3xl mx-auto px-4 py-10">
    <div class="flex flex-wrap gap-2 mb-4">
      <span class="text-xs px-2 py-0.5 rounded-full" style="background:#1e2030; color:#94a3b8; border:1px solid #2a2d3e;">Brand Reference</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">YOKE</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">Lifting Points</span>
      <span class="text-xs px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/20">EN 1677-5</span>
    </div>

    <h1 class="text-3xl md:text-4xl font-bold text-white mb-3 leading-tight">YOKE Lifting Points: Swivel Eye Bolt WLL Chart, Specs & Thread Guide</h1>
    <p class="text-gray-400 text-lg mb-8 leading-relaxed">YOKE International (Taiwan) manufactures swivel and rotating lifting points used globally for machine maintenance, offshore, and plant engineering. Unlike standard eye bolts, YOKE swivel points maintain full WLL at any sling angle (360° rotation, ±90° tilt).</p>

    <div class="answer-box mb-8">
      <p><strong>Key advantage:</strong> A standard DIN 580 eye bolt loses 50–70% WLL when loaded at 90°. A YOKE swivel lifting point retains its full rated WLL regardless of sling angle — critical for any lift where the crane hook is not directly above the attachment point.</p>
    </div>

    <div class="prose-rc">

      <h2>YOKE Swivel Lifting Point WLL Chart (EN 1677-5)</h2>
      <p>All swivel 360°/tilt ±90°. WLL at full angle — no reduction factor for sling angle. Design factor 4:1 per EN 1677-5.</p>

      <table>
        <thead>
          <tr>
            <th>Thread Size</th>
            <th>WLL</th>
            <th>WLL (t)</th>
            <th>Break Load (t)</th>
            <th>Standard</th>
          </tr>
        </thead>
        <tbody>
          {wllRows.map(([thread, wll_label, wll_t, bl, std]) => (
            <tr>
              <td style="font-family:'JetBrains Mono',monospace; color:#f59e0b; font-weight:600;">{thread}</td>
              <td style="font-weight:600;">{wll_label}</td>
              <td>{wll_t}</td>
              <td style="color:#64748b;">{bl}</td>
              <td style="color:#64748b; font-size:0.8rem;">{std}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p style="font-size:0.75rem; color:#475569;">Reference data. EN 1677-5 design factor is 4:1 (vs 5:1 for shackles under ASME B30.26). Verify against YOKE official catalog. Thread engagement must be ≥1× bolt diameter in steel.</p>

      <h2>YOKE vs DIN 580 Eye Bolt: When to Use Which</h2>
      <table>
        <thead><tr><th>Feature</th><th>DIN 580 Fixed Eye Bolt</th><th>YOKE Swivel Lifting Point</th></tr></thead>
        <tbody>
          <tr><td>In-line WLL</td><td>Full rated</td><td>Full rated</td></tr>
          <tr><td>WLL at 90° sling angle</td><td>25–50% of axial WLL (reduced)</td><td>100% of rated WLL — no reduction</td></tr>
          <tr><td>Rotation</td><td>Fixed — must align with load</td><td>360° swivel</td></tr>
          <tr><td>Cost</td><td>Lower</td><td>Higher (but eliminates angle penalty cost)</td></tr>
          <tr><td>When to use</td><td>Vertical lifts only, hook directly above</td><td>Any angular lift, machine maintenance, offshore</td></tr>
        </tbody>
      </table>

      <h2>Thread Engagement Requirements</h2>
      <p>Insufficient thread engagement is the most common installation error with swivel lifting points. The screw portion must engage enough threads to develop the rated WLL in pull-out.</p>
      <table>
        <thead><tr><th>Material of tapped hole</th><th>Min. thread engagement</th></tr></thead>
        <tbody>
          <tr><td>Steel (≥ 600 MPa UTS)</td><td>1.0 × bolt diameter (1d)</td></tr>
          <tr><td>Steel (< 600 MPa UTS)</td><td>1.25 × bolt diameter</td></tr>
          <tr><td>Aluminum alloy</td><td>1.5 × bolt diameter</td></tr>
          <tr><td>Cast iron</td><td>1.5 × bolt diameter (verify hardness)</td></tr>
        </tbody>
      </table>
      <p>Example: M20 lifting point in 600 MPa steel requires at least 20 mm of thread engagement (1d = 1 × 20 mm). If your tapped hole is only 15 mm deep, the pull-out strength is below the 3.15 t WLL.</p>

      <h2>Frequently Asked Questions</h2>
      {faqItems.map(({ q, a }) => (
        <details style="border:1px solid #1e2030; border-radius:0.5rem; padding:0.75rem 1rem; margin-bottom:0.75rem; cursor:pointer;">
          <summary style="font-weight:600; color:#f1f5f9; list-style:none;">{q}</summary>
          <p style="margin-top:0.5rem; font-size:0.9rem;">{a}</p>
        </details>
      ))}

    </div>

    <div class="cta-box my-8">
      <p class="text-white font-bold text-base mb-2">Calculate the load on each lifting point</p>
      <p class="text-gray-400 text-sm mb-4">Use the crane load calculator to find the vertical force on each attachment point, then match to the YOKE size chart above.</p>
      <a href="/crane-load-calculator" class="accent-btn">Crane Load Calculator</a>
    </div>

    <div class="mt-10 pt-8" style="border-top:1px solid #1e2030;">
      <p class="text-gray-500 text-sm font-semibold mb-3">Other brand references</p>
      <div class="grid sm:grid-cols-3 gap-3 text-sm">
        <a href="/brands/crosby-g-2150/" class="cta-box block hover:border-amber-500/40 transition-colors" style="padding:1rem; margin:0;">
          <p class="text-white font-semibold">Crosby G-2150</p>
          <p class="text-gray-500 text-xs mt-0.5">Industry-standard bow shackle</p>
        </a>
        <a href="/brands/gunnebo/" class="cta-box block hover:border-amber-500/40 transition-colors" style="padding:1rem; margin:0;">
          <p class="text-white font-semibold">Gunnebo Viking & Titan</p>
          <p class="text-gray-500 text-xs mt-0.5">EN 13889 certified shackles</p>
        </a>
        <a href="/brands/cm-shackles/" class="cta-box block hover:border-amber-500/40 transition-colors" style="padding:1rem; margin:0;">
          <p class="text-white font-semibold">CM / Columbus McKinnon</p>
          <p class="text-gray-500 text-xs mt-0.5">Shackle WLL chart</p>
        </a>
      </div>
    </div>

    <p class="mt-8 text-xs text-gray-600">Disclaimer: Independent engineering reference. RiggingCalculators.com is not affiliated with YOKE International. Verify against manufacturer's current catalog before use.</p>
  </div>
</BlogBase>

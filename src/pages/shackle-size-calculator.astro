---
import Base from '../layouts/Base.astro';
import { CROSBY_SHACKLES } from '../data/shackles';

const siteUrl = 'https://riggingcalculators.com';

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    "name": "Shackle Size Calculator",
    "url": `${siteUrl}/shackle-size-calculator`,
    "applicationCategory": "EngineeringApplication",
    "operatingSystem": "Web",
    "description": "Free online shackle size calculator. Enter load, get exact Crosby model, WLL, pin diameter & weight. ASME B30.26 compliant. No signup.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    },
    "provider": {
      "@type": "Organization",
      "name": "Rigging Calculators",
      "url": siteUrl
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What size shackle do I need for my load?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Select a shackle with a Working Load Limit (WLL) equal to or greater than your load. Enter your load in tonnes above and the calculator returns the exact Crosby model, size, pin diameter, and weight. ASME B30.26 requires the WLL to never be exceeded."
        }
      },
      {
        "@type": "Question",
        "name": "What is the difference between a screw pin and bolt type shackle?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Screw pin shackles (e.g. Crosby G-209) use a threaded pin for quick connect/disconnect and are best for temporary, frequently inspected rigging. Bolt type shackles (e.g. Crosby G-2130) use a bolt, nut, and cotter pin that resist vibration loosening, making them suitable for long-term or permanent installations."
        }
      },
      {
        "@type": "Question",
        "name": "Should I choose alloy or carbon steel shackles?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Alloy steel shackles (G-209, G-2130) offer higher strength-to-weight ratio and greater impact resistance for critical lifts. Carbon steel shackles (S-209) are an economical choice for general-purpose, non-critical rigging. Both meet ASME B30.26 when manufactured to spec."
        }
      },
      {
        "@type": "Question",
        "name": "What safety factor do shackles have?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Crosby anchor shackles are designed with a 5:1 safety factor, meaning the minimum breaking load is at least 5 times the Working Load Limit. The WLL already includes this factor — never exceed the WLL, regardless of the calculated safety margin."
        }
      },
      {
        "@type": "Question",
        "name": "Can I use a shackle at an angle or for side loading?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Shackle WLL ratings are for inline (vertical) pulls only. Side loading, angular loading, or choker configurations reduce capacity — refer to ASME B30.26 reduction factors or the manufacturer's derating tables. For multi-leg rigs, calculate the actual tension per leg with our Sling Angle Calculator before selecting a shackle."
        }
      }
    ]
  }
];

const breadcrumbItems = [
  { name: "Home", url: "/" },
  { name: "Shackle Size Calculator", url: "/shackle-size-calculator" }
];

const g209 = CROSBY_SHACKLES.filter(s => s.model === 'G-209');
const g2130 = CROSBY_SHACKLES.filter(s => s.model === 'G-2130');
const s209 = CROSBY_SHACKLES.filter(s => s.model === 'S-209');
---

<Base
  title="Shackle Size Calculator — Find the Right Shackle | riggingcalculators.com"
  description="Free online shackle size calculator. Enter load, get exact Crosby model, WLL, pin diameter & weight. ASME B30.26 compliant. No signup."
  canonical="/shackle-size-calculator"
  jsonLd={jsonLd}
  breadcrumbItems={breadcrumbItems}
  gaId="G-XXXXXXX"
>

<!-- Header -->
<header class="sticky top-0 z-50 glass-card border-b border-ink-600/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2">
        <span class="text-2xl">⚓</span>
        <span class="font-bold text-xl text-white">Rigging<span class="text-amber-400">Calculators</span></span>
      </a>
      <nav class="hidden md:flex items-center gap-8">
        <a href="#calculator" class="text-gray-400 hover:text-amber-400 transition">Calculator</a>
        <a href="#specs" class="text-gray-400 hover:text-amber-400 transition">Spec Table</a>
        <a href="#how-to-choose" class="text-gray-400 hover:text-amber-400 transition">How to Choose</a>
        <a href="#faq" class="text-gray-400 hover:text-amber-400 transition">FAQ</a>
      </nav>
      <button class="accent-btn text-sm px-4 py-2" onclick="document.getElementById('calculator').scrollIntoView({behavior:'smooth'})">
        Calculate Now
      </button>
    </div>
  </div>
</header>

<!-- Hero + Calculator -->
<section class="relative py-20 lg:py-28 overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-ink-900 via-ink-950 to-ink-900"></div>
  <div class="absolute inset-0 opacity-5" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23f59e0b' fill-opacity='0.4'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"></div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Copy -->
      <div>
        <div class="inline-flex items-center gap-2 bg-amber-500/10 border border-amber-500/30 rounded-full px-4 py-1.5 mb-6">
          <span class="w-2 h-2 bg-amber-400 rounded-full animate-pulse"></span>
          <span class="text-amber-400 text-sm font-medium">ASME B30.26 Compliant</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-6">
          Shackle Size Calculator<br/>
          <span class="text-amber-400">Find the Right Shackle</span>
        </h1>

        <p class="text-xl text-gray-400 mb-8 leading-relaxed">
          Enter your load and get the exact Crosby model, WLL, pin diameter &amp; weight. Screw pin or bolt type, alloy or carbon. No signup.
        </p>

        <div class="flex flex-wrap gap-4">
          <button class="accent-btn" onclick="document.getElementById('calculator').scrollIntoView({behavior:'smooth'})">
            Calculate Now
          </button>
          <a href="#specs" class="accent-btn-secondary">View Spec Table</a>
        </div>

        <div class="mt-10 grid grid-cols-3 gap-6">
          <div>
            <div class="text-2xl font-bold text-amber-400">3 sec</div>
            <div class="text-sm text-gray-500">to get specs</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-amber-400">100%</div>
            <div class="text-sm text-gray-500">free forever</div>
          </div>
          <div>
            <div class="text-2xl font-bold text-amber-400">5:1</div>
            <div class="text-sm text-gray-500">design factor</div>
          </div>
        </div>
      </div>

      <!-- Right: Calculator -->
      <div id="calculator" class="glass-card p-6 lg:p-8">
        <h2 class="text-xl font-bold text-white mb-6 flex items-center gap-2">
          <span class="text-amber-400">⚓</span> Shackle Size Calculator
        </h2>

        <form id="shackle-form" class="space-y-4">
          <div>
            <label class="block text-sm font-medium text-gray-400 mb-2">Load (tonnes)</label>
            <input
              type="number"
              id="load-input"
              class="field"
              placeholder="e.g. 10"
              min="0.5"
              max="120"
              step="0.5"
              required
            />
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium text-gray-400 mb-2">Type</label>
              <select id="type-input" class="field">
                <option value="">Any (recommend)</option>
                <option value="screw-pin">Screw Pin</option>
                <option value="bolt-type">Bolt Type</option>
              </select>
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-400 mb-2">Material</label>
              <select id="material-input" class="field">
                <option value="">Any (recommend)</option>
                <option value="alloy">Alloy Steel</option>
                <option value="carbon">Carbon Steel</option>
              </select>
            </div>
          </div>

          <button type="submit" class="accent-btn w-full">
            Calculate Shackle Size
          </button>
        </form>

        <!-- Result -->
        <div id="shackle-result" class="hidden mt-6 result-panel">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-bold text-amber-400">Recommended Shackle</h3>
            <span id="result-model" class="bg-amber-500/20 text-amber-400 px-3 py-1 rounded-full text-sm font-mono"></span>
          </div>

          <div class="grid grid-cols-2 gap-4 text-sm">
            <div>
              <span class="text-gray-500">WLL:</span>
              <span id="result-wll" class="text-white font-mono font-bold ml-2"></span>
            </div>
            <div>
              <span class="text-gray-500">Size:</span>
              <span id="result-size" class="text-white font-mono ml-2"></span>
            </div>
            <div>
              <span class="text-gray-500">Pin Ø:</span>
              <span id="result-pin" class="text-white font-mono ml-2"></span>
            </div>
            <div>
              <span class="text-gray-500">Weight:</span>
              <span id="result-weight" class="text-white font-mono ml-2"></span>
            </div>
            <div>
              <span class="text-gray-500">Safety Factor:</span>
              <span id="result-safety" class="text-white font-mono ml-2"></span>
            </div>
            <div>
              <span class="text-gray-500">Material:</span>
              <span id="result-material" class="text-white font-mono ml-2"></span>
            </div>
          </div>

          <div id="result-warning" class="hidden mt-4 p-3 bg-yellow-500/10 border border-yellow-500/30 rounded-lg text-sm text-yellow-400">
          </div>

          <div class="mt-6 flex gap-3">
            <button class="accent-btn text-sm px-4 py-2" onclick="document.getElementById('rfq-modal').classList.remove('hidden')">
              Get a Quote
            </button>
            <button class="accent-btn-secondary text-sm px-4 py-2" onclick="document.getElementById('shackle-result').classList.add('hidden')">
              Recalculate
            </button>
          </div>
        </div>

        <p class="disclaimer">
          Based on ASME B30.26. Not a substitute for qualified rigger judgment. Always verify with manufacturer data.
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Spec Table -->
<section id="specs" class="py-20 bg-ink-900/50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-white mb-4">Crosby Shackle Spec Table — G-209 / G-2130 / S-209</h2>
      <p class="text-gray-400 max-w-3xl mx-auto">Complete ASME B30.26 WLL data with dimensions. WLL in metric tonnes, dimensions in millimetres, weight in kilograms.</p>
    </div>

    <!-- G-209 -->
    <div class="mb-12">
      <h3 class="text-xl font-bold text-amber-400 mb-4 font-mono">G-209 — Alloy Screw Pin Anchor</h3>
      <div class="overflow-x-auto glass-card">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-gray-500 border-b border-ink-600/30">
              <th class="p-3">Size (in)</th>
              <th class="p-3">WLL (t)</th>
              <th class="p-3">A — Bow (mm)</th>
              <th class="p-3">B — Length (mm)</th>
              <th class="p-3">C — Pin Ø (mm)</th>
              <th class="p-3">D — Body Ø (mm)</th>
              <th class="p-3">E — Eye Ø (mm)</th>
              <th class="p-3">F — Eye Gap (mm)</th>
              <th class="p-3">Weight (kg)</th>
            </tr>
          </thead>
          <tbody>
            {g209.map(s => (
              <tr class="border-b border-ink-600/10 hover:bg-amber-500/5 transition">
                <td class="p-3 font-mono text-white">{s.size_inch}"</td>
                <td class="p-3 font-mono font-bold text-amber-400">{s.wll_tonnes}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.a}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.b}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.c}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.d}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.e}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.f}</td>
                <td class="p-3 font-mono text-gray-300">{s.weight_kg}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- G-2130 -->
    <div class="mb-12">
      <h3 class="text-xl font-bold text-amber-400 mb-4 font-mono">G-2130 — Alloy Bolt Type Anchor</h3>
      <div class="overflow-x-auto glass-card">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-gray-500 border-b border-ink-600/30">
              <th class="p-3">Size (in)</th>
              <th class="p-3">WLL (t)</th>
              <th class="p-3">A — Bow (mm)</th>
              <th class="p-3">B — Length (mm)</th>
              <th class="p-3">C — Pin Ø (mm)</th>
              <th class="p-3">D — Body Ø (mm)</th>
              <th class="p-3">E — Eye Ø (mm)</th>
              <th class="p-3">F — Eye Gap (mm)</th>
              <th class="p-3">Weight (kg)</th>
            </tr>
          </thead>
          <tbody>
            {g2130.map(s => (
              <tr class="border-b border-ink-600/10 hover:bg-amber-500/5 transition">
                <td class="p-3 font-mono text-white">{s.size_inch}"</td>
                <td class="p-3 font-mono font-bold text-amber-400">{s.wll_tonnes}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.a}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.b}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.c}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.d}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.e}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.f}</td>
                <td class="p-3 font-mono text-gray-300">{s.weight_kg}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- S-209 -->
    <div>
      <h3 class="text-xl font-bold text-amber-400 mb-4 font-mono">S-209 — Carbon Screw Pin Anchor</h3>
      <div class="overflow-x-auto glass-card">
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-gray-500 border-b border-ink-600/30">
              <th class="p-3">Size (in)</th>
              <th class="p-3">WLL (t)</th>
              <th class="p-3">A — Bow (mm)</th>
              <th class="p-3">B — Length (mm)</th>
              <th class="p-3">C — Pin Ø (mm)</th>
              <th class="p-3">D — Body Ø (mm)</th>
              <th class="p-3">E — Eye Ø (mm)</th>
              <th class="p-3">F — Eye Gap (mm)</th>
              <th class="p-3">Weight (kg)</th>
            </tr>
          </thead>
          <tbody>
            {s209.map(s => (
              <tr class="border-b border-ink-600/10 hover:bg-amber-500/5 transition">
                <td class="p-3 font-mono text-white">{s.size_inch}"</td>
                <td class="p-3 font-mono font-bold text-amber-400">{s.wll_tonnes}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.a}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.b}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.c}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.d}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.e}</td>
                <td class="p-3 font-mono text-gray-300">{s.dimensions.f}</td>
                <td class="p-3 font-mono text-gray-300">{s.weight_kg}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>

    <!-- Crosby brand links -->
    <div class="mt-12 grid md:grid-cols-3 gap-4">
      <a href="/crosby-g-209-capacity" class="glass-card p-4 hover:border-amber-500/50 transition block">
        <div class="text-amber-400 font-mono font-bold">G-209</div>
        <div class="text-sm text-gray-400 mt-1">Full capacity &amp; dimensions page</div>
      </a>
      <a href="/crosby-g-2130-capacity" class="glass-card p-4 hover:border-amber-500/50 transition block">
        <div class="text-amber-400 font-mono font-bold">G-2130</div>
        <div class="text-sm text-gray-400 mt-1">Full capacity &amp; dimensions page</div>
      </a>
      <a href="/crosby-s-209-capacity" class="glass-card p-4 hover:border-amber-500/50 transition block">
        <div class="text-amber-400 font-mono font-bold">S-209</div>
        <div class="text-sm text-gray-400 mt-1">Full capacity &amp; dimensions page</div>
      </a>
    </div>
  </div>
</section>

<!-- How to Choose -->
<section id="how-to-choose" class="py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-white mb-4">How to Choose the Right Shackle</h2>
      <p class="text-gray-400">A 5-step field guide based on ASME B30.26.</p>
    </div>

    <div class="space-y-4">
      <div class="glass-card p-6">
        <h3 class="text-lg font-bold text-amber-400 mb-2">1. Determine the working load</h3>
        <p class="text-gray-400 leading-relaxed">Know the actual load weight — not an estimate. For multi-leg slings, divide the load by the number of legs, then apply the tension factor for your sling angle (see our <a href="/sling-angle-calculator" class="text-amber-400 hover:underline">Sling Angle Calculator</a>). Use the highest-tension leg for shackle selection.</p>
      </div>
      <div class="glass-card p-6">
        <h3 class="text-lg font-bold text-amber-400 mb-2">2. Select WLL ≥ load</h3>
        <p class="text-gray-400 leading-relaxed">The shackle Working Load Limit must equal or exceed the load on that connection. Never "stretch" a size — the 5:1 design factor in WLL is already your engineered margin. Add one size up for dynamic or shock loading.</p>
      </div>
      <div class="glass-card p-6">
        <h3 class="text-lg font-bold text-amber-400 mb-2">3. Pick pin style: screw pin vs bolt type</h3>
        <p class="text-gray-400 leading-relaxed">Screw pin (G-209) for fast, temporary connections that are checked before every lift. Bolt type (G-2130) for long-term installations, vibration-prone rigs, or any connection that can't be re-checked daily — the nut and cotter pin will not vibrate loose.</p>
      </div>
      <div class="glass-card p-6">
        <h3 class="text-lg font-bold text-amber-400 mb-2">4. Choose material: alloy vs carbon</h3>
        <p class="text-gray-400 leading-relaxed">Alloy steel (G-209, G-2130) for critical lifts, harsh environments, and where impact toughness matters. Carbon steel (S-209) is a cost-effective choice for general-purpose rigging within its 17-tonne WLL ceiling.</p>
      </div>
      <div class="glass-card p-6">
        <h3 class="text-lg font-bold text-amber-400 mb-2">5. Verify geometry and clearance</h3>
        <p class="text-gray-400 leading-relaxed">Check bow width (A), inside length (B), and pin diameter (C) against your sling, hook, or wire rope eye. Avoid side loading — WLL ratings assume a straight inline pull. For full dimensional reference, see our <a href="/shackle-size-chart" class="text-amber-400 hover:underline">Shackle Size Chart</a> and <a href="/swl-chart" class="text-amber-400 hover:underline">SWL Chart</a>.</p>
      </div>
    </div>
  </div>
</section>

<!-- Screw Pin vs Bolt Type -->
<section class="py-20 bg-ink-900/50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-white mb-4">Screw Pin vs Bolt Type Shackle</h2>
      <p class="text-gray-400">Which pin style is right for your application?</p>
    </div>

    <div class="overflow-x-auto glass-card">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-gray-500 border-b border-ink-600/30">
            <th class="p-4"></th>
            <th class="p-4 text-amber-400 font-semibold">Screw Pin (G-209)</th>
            <th class="p-4 text-amber-400 font-semibold">Bolt Type (G-2130)</th>
          </tr>
        </thead>
        <tbody class="text-gray-300">
          <tr class="border-b border-ink-600/10">
            <td class="p-4 font-semibold text-white">Pin mechanism</td>
            <td class="p-4">Threaded pin, hand-tightened</td>
            <td class="p-4">Bolt + nut + cotter pin</td>
          </tr>
          <tr class="border-b border-ink-600/10">
            <td class="p-4 font-semibold text-white">Connection speed</td>
            <td class="p-4">Fast — no tools needed</td>
            <td class="p-4">Slower — wrench required</td>
          </tr>
          <tr class="border-b border-ink-600/10">
            <td class="p-4 font-semibold text-white">Vibration resistance</td>
            <td class="p-4">Fair — pin can back off</td>
            <td class="p-4">Excellent — cotter pin locks it</td>
          </tr>
          <tr class="border-b border-ink-600/10">
            <td class="p-4 font-semibold text-white">Best for</td>
            <td class="p-4">Temporary, frequently changed rigging</td>
            <td class="p-4">Permanent / semi-permanent installations</td>
          </tr>
          <tr class="border-b border-ink-600/10">
            <td class="p-4 font-semibold text-white">Inspection</td>
            <td class="p-4">Pin must be checked before every lift</td>
            <td class="p-4">Check torque &amp; cotter periodically</td>
          </tr>
          <tr class="border-b border-ink-600/10">
            <td class="p-4 font-semibold text-white">Typical cost</td>
            <td class="p-4">Lower</td>
            <td class="p-4">Higher (complex pin assembly)</td>
          </tr>
          <tr>
            <td class="p-4 font-semibold text-white">WLL range</td>
            <td class="p-4 font-mono">0.5 – 120 t</td>
            <td class="p-4 font-mono">0.5 – 120 t</td>
          </tr>

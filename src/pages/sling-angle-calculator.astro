<!-- Calculator Script -->
<script is:inline>
  // Chain sling WLL table (Grade 80, single leg vertical, tonnes)
  const CHAIN_WLL = [
    { dia: '6mm', wll: 1.12 },
    { dia: '8mm', wll: 2.0 },
    { dia: '10mm', wll: 3.15 },
    { dia: '13mm', wll: 5.3 },
    { dia: '16mm', wll: 8.0 },
    { dia: '18mm', wll: 11.2 },
    { dia: '20mm', wll: 15.0 },
    { dia: '23mm', wll: 21.2 },
    { dia: '26mm', wll: 31.5 },
  ];

  const SLING_TYPE_LABELS = {
    'chain': 'Chain Sling',
    'web': 'Web Sling',
    'wire-rope': 'Wire Rope Sling'
  };

  document.getElementById('sling-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const totalLoad = parseFloat(document.getElementById('load-input').value);
    const legs = parseInt(document.getElementById('legs-input').value, 10);
    const angle = parseFloat(document.getElementById('angle-input').value);
    const slingType = document.getElementById('sling-type-input').value;
    
    if (!totalLoad || totalLoad <= 0) return;
    
    // Core math: tensionFactor = 1/sin(angle), loadPerLeg = (totalLoad/legs) × tensionFactor
    const rad = angle * Math.PI / 180;
    const tensionFactor = 1 / Math.sin(rad);
    const loadPerLeg = (totalLoad / legs) * tensionFactor;
    const verticalForce = totalLoad / legs;
    const horizontalForce = verticalForce / Math.tan(rad);
    
    // Display results
    document.getElementById('result-badge').textContent = legs + ' leg @ ' + angle + '°';
    document.getElementById('result-leg-load').textContent = verticalForce.toFixed(2) + ' t';
    document.getElementById('result-tension').textContent = loadPerLeg.toFixed(2) + ' t';
    document.getElementById('result-factor').textContent = '× ' + tensionFactor.toFixed(3);
    document.getElementById('result-vertical').textContent = verticalForce.toFixed(2) + ' t';
    document.getElementById('result-horizontal').textContent = horizontalForce.toFixed(2) + ' t';
    
    // Recommended chain sling: smallest chain WLL >= tension per leg
    const chain = CHAIN_WLL.find(c => c.wll >= loadPerLeg);
    const chainEl = document.getElementById('result-chain');
    if (chain) {
      chainEl.textContent = chain.dia + ' Grade 80 chain (' + chain.wll.toFixed(2) + ' t WLL)';
    } else {
      chainEl.textContent = 'Exceeds 26mm chain — consult manufacturer';
    }
    
    // Warnings
    const warningEl = document.getElementById('result-warning');
    const noteEl = document.getElementById('result-note');
    
    if (angle < 30) {
      warningEl.textContent = '⚠ Angle below 30° from horizontal — NOT recommended by ASME B30.9. Tension exceeds 2× the vertical share and horizontal squeeze may damage the load. Use a spreader beam or lengthen legs.';
      warningEl.classList.remove('hidden');
    } else if (angle < 45) {
      warningEl.textContent = '⚠ Shallow angle: each leg carries ' + tensionFactor.toFixed(2) + '× its vertical share. Verify attachment points and load can handle ' + horizontalForce.toFixed(1) + ' t horizontal squeeze per leg.';
      warningEl.classList.remove('hidden');
    } else {
      warningEl.classList.add('hidden');
    }
    
    if (slingType !== 'chain' && chain) {
      noteEl.textContent = 'Note: chain size shown as reference. For ' + (SLING_TYPE_LABELS[slingType] || slingType) + ', select a sling whose angle-rated WLL ≥ ' + loadPerLeg.toFixed(2) + ' t per leg. See the Sling Capacity Chart.';
      noteEl.classList.remove('hidden');
    } else {
      noteEl.classList.add('hidden');
    }
    
    document.getElementById('sling-result').classList.remove('hidden');
    
    // Track event
    if (typeof gtag !== 'undefined') {
      gtag('event', 'tool_complete', {
        tool_name: 'sling_angle_calculator',
        result_value: parseFloat(loadPerLeg.toFixed(2)),
        legs: legs,
        angle: angle,
        sling_type: slingType
      });
    }
  });

  // RFQ form
  document.getElementById('rfq-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    if (typeof gtag !== 'undefined') {
      gtag('event', 'rfq_submit', {
        tool_name: 'sling_angle_calculator'
      });
    }
    
    this.innerHTML = '<div class="text-center py-8"><div class="text-4xl mb-4">✅</div><h4 class="text-xl font-bold text-white mb-2">RFQ Submitted</h4><p class="text-gray-400">We will contact you within 24 hours with quotes from vetted suppliers.</p></div>';
  });
</script>


      <a href="/sling-angle-calculator" class="accent-btn">Open Calculator</a>
    </div>

    <div class="mt-8 pt-8" style="border-top:1px solid #1e2030;">
      <p class="text-gray-500 text-sm font-semibold mb-3">Related articles</p>
      <div class="grid sm:grid-cols-2 gap-3 text-sm">
        <a href="/blog/shackle-size-selection-guide/" class="cta-box block hover:border-amber-500/40 transition-colors" style="padding:1rem; margin:0;">
          <p class="text-white font-semibold">Shackle Size Selection Guide</p>

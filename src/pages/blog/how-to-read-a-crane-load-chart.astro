---
import BlogBase from "../../layouts/BlogBase.astro";

const pubDate = "2026-10-01";

const faqItems = [
  {
    q: "What is 'working radius' on a crane load chart?",
    a: "Working radius is the horizontal distance from the center of the crane's rotation to the center of the hook. It is measured at the hook, not along the boom. As the boom extends or lowers, the working radius increases and the rated capacity drops — sometimes dramatically.",
  },
  {
    q: "Does rated capacity include the weight of the hook block and rigging?",
    a: "No. The load chart capacity is the gross capacity at the hook. You must subtract all rigging hardware weights — hook block, headache ball, below-hook devices, spreader bars, slings, and shackles — before you know the net payload the crane can lift. This subtraction is called 'deducting hook and rigging.'",
  },
  {
    q: "What is the 80% rule for crane lifts?",
    a: "Many lift plans limit picks to 80% of the crane's rated capacity at the working radius. This 20% margin accounts for dynamic loads, ground settlement, load swing, and uncertainty in the load weight. ASME B30.5 does not mandate 80%, but many company lift procedures and permit systems do.",
  },
  {
    q: "What is the difference between on-outriggers and on-rubber capacity?",
    a: "On-outriggers capacity assumes the outriggers are fully extended and the crane is level on solid ground. On-rubber (on-tires) capacity is typically 50–70% less because the tires and suspension flex, reducing stability. Always confirm your outrigger configuration before reading capacity from the correct section of the load chart.",
  },
  {
    q: "Why does increasing boom length reduce crane capacity?",
    a: "A longer boom shifts the crane's center of gravity further forward, increasing the overturning moment. The structural strength of the boom itself also limits the load it can carry in bending. Both factors reduce rated capacity as boom length grows.",
  },
  {
    q: "How do I find the right page in a multi-section load chart?",
    a: "Most mobile crane load charts are organized first by crane configuration (main boom only, main boom + jib, fly jib), then by counterweight setting, then by outrigger/on-rubber. Select the section that exactly matches your setup. Using the wrong section is a critical error — capacities can differ by 40% or more.",
  },
  {
    q: "What is a 'pick-and-carry' capacity?",
    a: "Pick-and-carry is when the crane lifts a load and travels with it on tires. This requires a specific section of the load chart (usually much lower capacity) because dynamic forces from traveling — bumps, turns, acceleration — multiply the load moment. Always use the pick-and-carry table, not the stationary on-rubber table.",
  },
  {
    q: "Can I interpolate between values on a load chart?",
    a: "Interpolation is acceptable only if the load chart explicitly permits it. Some manufacturers state 'do not interpolate — use the next lower capacity.' If interpolating is allowed, use linear interpolation between the two nearest radius values. Never extrapolate beyond the table's range.",
  },
];

const chartRows = [
  ["10 ft (3.0 m)", "60.0", "46.0", "35.0"],
  ["15 ft (4.6 m)", "44.0", "36.0", "28.0"],
  ["20 ft (6.1 m)", "33.0", "27.5", "21.5"],
  ["25 ft (7.6 m)", "26.0", "21.5", "16.5"],
  ["30 ft (9.1 m)", "20.5", "17.0", "13.0"],
  ["40 ft (12.2 m)", "13.0", "10.5", "8.0"],
  ["50 ft (15.2 m)", "8.5", "7.0", "5.5"],
  ["60 ft (18.3 m)", "—", "4.5", "3.5"],
  ["70 ft (21.3 m)", "—", "—", "2.5"],
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: "How to Read a Crane Load Chart: Radius, Boom Length & Capacity Explained",
    description: "Step-by-step guide to reading a crane load chart — working radius, boom length, on-outriggers vs on-rubber, hook deductions, and the 80% lift rule.",
    datePublished: pubDate,
    publisher: { "@type": "Organization", name: "RiggingCalculators.com", url: "https://riggingcalculators.com" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map(({ q, a }) => ({
      "@type": "Question",
      name: q,
      acceptedAnswer: { "@type": "Answer", text: a },
    })),
  },
];

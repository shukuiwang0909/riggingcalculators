    { construction: '6x7', core: 'FC', diameter_mm: 16, breaking_load_tonnes: 17.0, weight_kg_per_m: 0.93 },
  ];

  document.getElementById('wire-rope-form').addEventListener('submit', function(e) {
    e.preventDefault();

    const diameter = parseFloat(document.getElementById('diameter-input').value);
    const construction = document.getElementById('construction-input').value;
    const safetyFactor = parseFloat(document.getElementById('sf-input').value);

    if (!diameter || diameter <= 0) return;

    const rope = WIRE_ROPES.find(r => r.diameter_mm === diameter && r.construction === construction);

    if (!rope) {
      const available = [...new Set(WIRE_ROPES.filter(r => r.construction === construction).map(r => r.diameter_mm))].sort((a, b) => a - b);
      alert('No ' + construction + ' data for ' + diameter + 'mm. Available diameters: ' + available.join(', ') + ' mm');
      return;
    }

    const wll = rope.breaking_load_tonnes / safetyFactor;

    document.getElementById('rope-spec').textContent = rope.diameter_mm + 'mm ' + rope.construction + ' ' + rope.core;
    document.getElementById('result-breaking').textContent = rope.breaking_load_tonnes.toFixed(1) + ' t';
    document.getElementById('result-wll').textContent = wll.toFixed(2) + ' t';
    document.getElementById('result-weight').textContent = rope.weight_kg_per_m.toFixed(2) + ' kg/m';
    document.getElementById('result-sf').textContent = safetyFactor + ':1';

    const warningEl = document.getElementById('result-warning');
    if (safetyFactor < 5) {
      warningEl.textContent = '⚠️ Safety factor ' + safetyFactor + ':1 is below the ASME B30.9 minimum of 5:1 for general lifting. Verify this is acceptable for your application.';
      warningEl.classList.remove('hidden');
    } else {
      warningEl.classList.add('hidden');
    }

    document.getElementById('rope-result').classList.remove('hidden');

    // Track event
    if (typeof gtag !== 'undefined') {
      gtag('event', 'tool_complete', {
        tool_name: 'wire_rope_capacity_calculator',
        result_value: rope.breaking_load_tonnes,
        construction: construction,
        diameter_mm: diameter,
        safety_factor: safetyFactor
      });
    }
  });

  // RFQ form
  document.getElementById('rfq-form').addEventListener('submit', function(e) {
    e.preventDefault();

    if (typeof gtag !== 'undefined') {
      gtag('event', 'rfq_submit', {
        tool_name: 'wire_rope_capacity_calculator'
      });
    }

    this.innerHTML = '<div class="text-center py-8"><div class="text-4xl mb-4">✅</div><h4 class="text-xl font-bold text-white mb-2">RFQ Submitted</h4><p class="text-gray-400">We will contact you within 24 hours with quotes from vetted suppliers.</p></div>';
  });
</script>


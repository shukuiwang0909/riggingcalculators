---
import Base from '../../layouts/Base.astro';
import HomePage from '../../components/pages/HomePage.astro';
import { LOCALES, type Locale } from '../../config';
import { SITE } from '../../config';
import { getDict } from '../../i18n/ui';
import { p, TOOL_PATHS } from '../../i18n/paths';
import { webSite, faqPage, collectionPage } from '../../lib/jsonld';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = getDict(lang);
const path = p(lang, '/');

const meta = {
  en: {
    title: 'Rigging Calculators — Free Shackle, Sling Angle, Wire Rope & Crane Load Tools',
    description: 'Free engineering-grade rigging calculators: shackle sizing, sling angle tension, wire rope capacity and crane load checks. ASME B30.9 / B30.26 / ISO 2408 based. No signup.',
  },
  zh: {
    title: '吊装索具计算器 — 免费卸扣选型、吊装角度、钢丝绳载荷与吊车负荷工具',
    description: '免费工程级吊装计算器：卸扣选型、吊索角度张力、钢丝绳载荷与吊车负荷校核，基于 ASME B30.9 / B30.26 / ISO 2408 标准，无需注册。',
  },
} as const;

const tools =
  lang === 'en'
    ? [
        { name: 'Shackle Size Calculator', url: `${SITE.url}${p(lang, TOOL_PATHS.shackle)}` },
        { name: 'Sling Angle Calculator', url: `${SITE.url}${p(lang, TOOL_PATHS.sling)}` },
        { name: 'Wire Rope Capacity Calculator', url: `${SITE.url}${p(lang, TOOL_PATHS.rope)}` },
        { name: 'Crane Load Calculator', url: `${SITE.url}${p(lang, TOOL_PATHS.crane)}` },
        { name: 'Chain Sling WLL Calculator', url: `${SITE.url}${p(lang, TOOL_PATHS.chain)}` },
      ]
    : [
        { name: '卸扣尺寸计算器', url: `${SITE.url}${p(lang, TOOL_PATHS.shackle)}` },
        { name: '吊索角度计算器', url: `${SITE.url}${p(lang, TOOL_PATHS.sling)}` },
        { name: '钢丝绳载荷计算器', url: `${SITE.url}${p(lang, TOOL_PATHS.rope)}` },
        { name: '吊车负荷计算器', url: `${SITE.url}${p(lang, TOOL_PATHS.crane)}` },
        { name: '链条吊索 WLL 计算器', url: `${SITE.url}${p(lang, TOOL_PATHS.chain)}` },
      ];

const jsonLd = [
  webSite(),
  collectionPage(meta[lang].title, meta[lang].description, path, lang, tools),
  faqPage(t.faq.items),
];
---

<Base lang={lang} title={meta[lang].title} description={meta[lang].description} path={path} jsonLd={jsonLd}>
  <HomePage lang={lang} />
</Base>

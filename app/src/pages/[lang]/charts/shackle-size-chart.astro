---
import Base from '../../../layouts/Base.astro';
import ShackleChartPage from '../../../components/pages/ShackleChartPage.astro';
import { LOCALES, type Locale } from '../../../config';
import { getDict } from '../../../i18n/ui';
import { p, CHART_PATHS } from '../../../i18n/paths';
import { collectionPage, faqPage, breadcrumb } from '../../../lib/jsonld';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = getDict(lang);
const tp = t.chartPages.shackle;
const path = p(lang, CHART_PATHS.shackle);

const meta = {
  en: {
    title: 'Shackle Size Chart — Crosby G-209 / G-2130 / S-209 WLL & Dimensions',
    description: 'Complete Crosby shackle WLL tables: G-209 screw pin, G-2130 bolt type and S-209 carbon anchor shackles with size, pin diameter and weight. ASME B30.26.',
  },
  zh: {
    title: '卸扣规格表 — Crosby G-209 / G-2130 / S-209 WLL 与尺寸',
    description: 'Crosby 卸扣完整 WLL 表：G-209 螺丝销、G-2130 螺栓销与 S-209 碳钢弓形卸扣的规格、销轴直径与单重。依据 ASME B30.26。',
  },
} as const;

const jsonLd = [
  collectionPage(tp.title, meta[lang].description, path, lang),
  faqPage(t.shackle.faqItems),
  breadcrumb([
    { name: t.nav.home, path: p(lang, '/') },
    { name: t.nav.charts, path: `${p(lang, '/')}#charts` },
    { name: tp.title, path },
  ]),
];
---

<Base lang={lang} title={meta[lang].title} description={meta[lang].description} path={path} jsonLd={jsonLd}>
  <ShackleChartPage lang={lang} />
</Base>

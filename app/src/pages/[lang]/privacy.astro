---
import Base from '../../layouts/Base.astro';
import LegalPage from '../../components/pages/LegalPage.astro';
import { LOCALES, type Locale } from '../../config';
import { getDict } from '../../i18n/ui';
import { p, LEGAL_PATHS } from '../../i18n/paths';
import { breadcrumb } from '../../lib/jsonld';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = getDict(lang);
const path = p(lang, LEGAL_PATHS.privacy);

const meta = {
  en: {
    title: 'Privacy Policy — Rigging Calculators',
    description: 'How Rigging Calculators handles your data: local-only calculator inputs, minimal RFQ data collection, no advertising cookies.',
  },
  zh: {
    title: '隐私政策 — 吊装索具计算器',
    description: '本站数据处理方式说明：计算输入仅本地处理、询价数据最小化收集、无广告 Cookie。',
  },
} as const;

const jsonLd = [
  breadcrumb([
    { name: t.nav.home, path: p(lang, '/') },
    { name: t.legal.privacyTitle, path },
  ]),
];
---

<Base lang={lang} title={meta[lang].title} description={meta[lang].description} path={path} jsonLd={jsonLd}>
  <LegalPage lang={lang} kind="privacy" />
</Base>

---
import Base from '../../layouts/Base.astro';
import CranePage from '../../components/pages/CranePage.astro';
import { LOCALES, type Locale } from '../../config';
import { getDict } from '../../i18n/ui';
import { p, TOOL_PATHS } from '../../i18n/paths';
import { softwareApp, faqPage, breadcrumb } from '../../lib/jsonld';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = getDict(lang);
const path = p(lang, TOOL_PATHS.crane);

const meta = {
  en: {
    title: 'Crane Load Calculator — Radius, Load Moment & Utilization',
    description: 'Calculate working radius, load moment and utilization against your crane\'s rated capacity. Preliminary lift planning tool — verify with the manufacturer load chart.',
  },
  zh: {
    title: '吊车负荷计算器 — 作业半径、起重力矩与负荷率',
    description: '计算作业半径与起重力矩，并对照吊车载荷表额定载荷计算负荷率。吊装预规划工具——请以制造商载荷表复核。',
  },
} as const;

const jsonLd = [
  softwareApp(t.crane.title, meta[lang].description, path, lang),
  faqPage(t.crane.faqItems),
  breadcrumb([
    { name: t.nav.home, path: p(lang, '/') },
    { name: t.crane.title, path },
  ]),
];
---

<Base lang={lang} title={meta[lang].title} description={meta[lang].description} path={path} jsonLd={jsonLd}>
  <CranePage lang={lang} />
</Base>

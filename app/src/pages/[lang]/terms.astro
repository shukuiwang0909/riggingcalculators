---
import Base from '../../layouts/Base.astro';
import LegalPage from '../../components/pages/LegalPage.astro';
import { LOCALES, type Locale } from '../../config';
import { getDict } from '../../i18n/ui';
import { p, LEGAL_PATHS } from '../../i18n/paths';
import { breadcrumb } from '../../lib/jsonld';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = getDict(lang);
const path = p(lang, LEGAL_PATHS.terms);

const meta = {
  en: {
    title: 'Terms of Use — Rigging Calculators',
    description: 'Terms of use for the Rigging Calculators website: reference-only tools, acceptable use, intellectual property and liability.',
  },
  zh: {
    title: '使用条款 — 吊装索具计算器',
    description: '本站使用条款：工具仅供参考、合理使用规范、知识产权与责任限制。',
  },
} as const;

const jsonLd = [
  breadcrumb([
    { name: t.nav.home, path: p(lang, '/') },
    { name: t.legal.termsTitle, path },
  ]),
];
---

<Base lang={lang} title={meta[lang].title} description={meta[lang].description} path={path} jsonLd={jsonLd}>
  <LegalPage lang={lang} kind="terms" />
</Base>

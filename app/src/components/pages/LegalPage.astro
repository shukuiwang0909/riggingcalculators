---
import { getDict } from '../../i18n/ui';
import type { Locale } from '../../config';
import { SITE } from '../../config';

interface Props { lang: Locale; kind: 'privacy' | 'terms' | 'disclaimer'; }
const { lang, kind } = Astro.props;
const t = getDict(lang);

interface Section { h: string; p: string[]; }

const content: Record<Locale, Record<'privacy' | 'terms' | 'disclaimer', { title: string; sections: Section[] }>> = {
  en: {
    privacy: {
      title: 'Privacy Policy',
      sections: [
        { h: 'Overview', p: [
          `${SITE.name} ("we", "this site") provides free rigging and lifting calculators. We are committed to minimizing data collection: the calculators run entirely in your browser, and no account is required.`,
        ] },
        { h: 'Information We Collect', p: [
          'Calculator inputs (load, angle, diameter, etc.) are processed locally in your browser and are never transmitted to or stored on our servers.',
          'If you submit a Request-for-Quote form, we collect the contact details and requirements you provide (name, company, email, product type, quantity, requirements) solely for the purpose of responding to your inquiry.',
          'If analytics are enabled on this site, we collect anonymized usage data (page views, device type, approximate region) via Google Analytics. You can opt out with any standard ad/tracker blocker.',
        ] },
        { h: 'Cookies', p: [
          'We do not use advertising or tracking cookies of our own. If Google Analytics is enabled, it sets first-party cookies (_ga, _ga_*) with a retention period configured in Google Analytics. No cookie banner is otherwise required for the operation of this site.',
        ] },
        { h: 'Data Sharing & Retention', p: [
          'RFQ submissions are shared only with vetted suppliers for the purpose of preparing your quote. We do not sell personal data. RFQ correspondence is retained for up to 24 months, then deleted.',
        ] },
        { h: 'Your Rights & Contact', p: [
          `You may request access to, correction of, or deletion of your personal data at any time by emailing ${SITE.email}. If you are in the EEA/UK, you also have the right to lodge a complaint with your supervisory authority.`,
        ] },
      ],
    },
    terms: {
      title: 'Terms of Use',
      sections: [
        { h: 'Acceptance of Terms', p: [
          `By accessing ${SITE.name}, you agree to these Terms of Use. If you do not agree, do not use this site.`,
        ] },
        { h: 'Nature of the Service', p: [
          'This site provides reference calculators and specification charts for rigging and lifting equipment based on published standards (ASME B30.9, ASME B30.26, ISO 2408, EN 818-2, EN 1492-1) and publicly available manufacturer data.',
          'The tools are provided for preliminary sizing and reference only. They do not constitute engineering advice, a lift plan, or a substitute for the judgment of a qualified rigger or engineer.',
        ] },
        { h: 'Acceptable Use', p: [
          'You may use the calculators freely for commercial and non-commercial purposes. You may not scrape the site in bulk, misrepresent results as certified engineering output, or use the site in violation of applicable law.',
        ] },
        { h: 'Intellectual Property', p: [
          'The site design, code, and original content are the property of the site operator. Standards data remains the property of the respective standards bodies; manufacturer data remains the property of the respective manufacturers. "Crosby" is a trademark of The Crosby Group, LLC; this site is not affiliated with or endorsed by Crosby.',
        ] },
        { h: 'Limitation of Liability', p: [
          'To the maximum extent permitted by law, we accept no liability for any loss, damage, injury, or death arising from use of or reliance on this site. Rigging and lifting operations are inherently dangerous and must be planned and supervised by qualified personnel.',
        ] },
        { h: 'Changes', p: [
          `We may update these terms at any time. Continued use after changes constitutes acceptance. Questions: ${SITE.email}.`,
        ] },
      ],
    },
    disclaimer: {
      title: 'Disclaimer',
      sections: [
        { h: 'Reference Only — Verify Before Every Lift', p: [
          'ALL calculation results and specification data on this site are provided for REFERENCE ONLY. Before any lift, you must verify capacities against the current manufacturer documentation for the exact equipment in use, and the lift must be planned and supervised by a qualified person as required by applicable regulations (e.g., OSHA 1926/1910, ASME B30 series, local equivalents).',
        ] },
        { h: 'No Warranty', p: [
          'This site is provided "as is" without warranty of any kind, express or implied, including accuracy, completeness, merchantability, or fitness for a particular purpose. Standards are revised periodically; data here may not reflect the latest edition.',
        ] },
        { h: 'Calculation Scope', p: [
          'The crane load calculator reports geometry (radius, angle, load moment) and compares your load against a rated capacity YOU enter from a manufacturer load chart. It does not and cannot estimate crane capacity. The shackle, sling, and wire rope calculators use published nominal data; actual hardware must be selected with appropriate derating for hitch type, angle, temperature, environment, and dynamic loading.',
        ] },
        { h: 'Trademarks', p: [
          'Crosby®, G-209®, and related model designations are trademarks of The Crosby Group, LLC. References are for identification of specifications only and imply no affiliation or endorsement.',
        ] },
        { h: 'Contact', p: [
          `Report data errors to ${SITE.email} — we correct verified errors promptly.`,
        ] },
      ],
    },
  },
  zh: {
    privacy: {
      title: '隐私政策',
      sections: [
        { h: '概述', p: [
          `${SITE.name}（下称"本站"）提供免费的吊装索具计算器。我们坚持最小化数据收集：所有计算均在您的浏览器本地完成，无需注册账号。`,
        ] },
        { h: '我们收集的信息', p: [
          '计算器输入（载荷、角度、直径等）仅在您的浏览器本地处理，不会传输或存储到我们的服务器。',
          '如果您提交询价表单，我们会收集您主动提供的联系信息与需求（姓名、公司、邮箱、产品类型、数量、需求说明），仅用于回复您的询价。',
          '如本站启用统计分析，我们将通过 Google Analytics 收集匿名使用数据（页面浏览量、设备类型、大致地区）。您可以使用任何常规广告/追踪拦截工具选择退出。',
        ] },
        { h: 'Cookie', p: [
          '本站自身不使用广告或追踪 Cookie。如启用 Google Analytics，它会设置第一方 Cookie（_ga、_ga_*），保留期在 Google Analytics 中配置。除此之外本站运行无需 Cookie 弹窗。',
        ] },
        { h: '数据共享与保留', p: [
          '询价内容仅与经过筛选的供应商共享，用于为您准备报价。我们不出售个人数据。询价往来记录最多保留 24 个月，随后删除。',
        ] },
        { h: '您的权利与联系方式', p: [
          `您可以随时发送邮件至 ${SITE.email}，要求访问、更正或删除您的个人数据。如您位于欧洲经济区/英国，您还有权向当地监管机构投诉。`,
        ] },
      ],
    },
    terms: {
      title: '使用条款',
      sections: [
        { h: '接受条款', p: [
          `访问 ${SITE.name} 即表示您同意本使用条款。如您不同意，请勿使用本站。`,
        ] },
        { h: '服务性质', p: [
          '本站基于公开标准（ASME B30.9、ASME B30.26、ISO 2408、EN 818-2、EN 1492-1）与公开的制造商数据，提供吊装索具的参考计算器与规格表。',
          '这些工具仅供初步选型与参考，不构成工程建议或吊装方案，也不能替代合格起重人员或工程师的判断。',
        ] },
        { h: '合理使用', p: [
          '您可以出于商业或非商业目的自由使用计算器。但不得批量抓取本站内容，不得将计算结果冒充为经认证的工程结论，不得违反适用法律使用本站。',
        ] },
        { h: '知识产权', p: [
          '本站的设计、代码与原创内容归本站运营方所有。标准数据归相应标准组织所有，制造商数据归相应制造商所有。"Crosby" 是 The Crosby Group, LLC 的商标；本站与 Crosby 无关联，亦未获其背书。',
        ] },
        { h: '责任限制', p: [
          '在法律允许的最大范围内，对于因使用或依赖本站而产生的任何损失、损害、伤亡，我们不承担任何责任。吊装作业具有固有风险，必须由合格人员策划与监督。',
        ] },
        { h: '条款变更', p: [
          `我们可能随时更新本条款，变更后继续使用即视为接受。如有疑问请联系：${SITE.email}。`,
        ] },
      ],
    },
    disclaimer: {
      title: '免责声明',
      sections: [
        { h: '仅供参考——每次吊装前必须核实', p: [
          '本站所有计算结果与规格数据仅供参考。任何吊装作业前，必须对照所使用设备的最新制造商文件核实额定载荷，并由合格人员按适用法规（如 OSHA 1926/1910、ASME B30 系列或当地等效法规）策划与监督吊装。',
        ] },
        { h: '无担保', p: [
          '本站按"现状"提供，不作任何明示或默示担保，包括准确性、完整性、适销性或特定用途适用性。标准会定期修订，本站数据可能未反映最新版本。',
        ] },
        { h: '计算范围说明', p: [
          '吊车负荷计算器仅输出几何参数（半径、角度、起重力矩），并将吊重与您从制造商载荷表中查得的额定载荷比较。它不能也不会估算吊车能力。卸扣、吊索与钢丝绳计算器使用公开的标称数据；实际选型必须根据拴挂方式、角度、温度、环境与动载进行相应折减。',
        ] },
        { h: '商标', p: [
          'Crosby®、G-209® 及相关型号名称为 The Crosby Group, LLC 的商标。引用仅为标识规格之用，不代表任何关联或背书关系。',
        ] },
        { h: '联系我们', p: [
          `如发现数据错误，请发送至 ${SITE.email} —— 我们会在核实后及时更正。`,
        ] },
      ],
    },
  },
};

const doc = content[lang][kind];
const updated = '2026-09-17';
---

<section class="relative dotgrid border-b border-[#1e1e1e]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pt-12 pb-12">
    <nav class="micro mb-8 flex items-center gap-2 no-print" aria-label="Breadcrumb">
      <a href={`/${lang}/`} class="hover:text-[#f27e40] transition-colors">{t.nav.home}</a>
      <span aria-hidden="true">›</span>
      <span class="!text-[#9d9d9d]">{doc.title}</span>
    </nav>
    <h1 class="display text-4xl sm:text-5xl text-white mb-4">{doc.title}</h1>
    <p class="micro">{t.legal.updated}: {updated}</p>
  </div>
</section>

<section class="py-14 lg:py-16">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    {doc.sections.map((s, i) => (
      <article class="reveal" style={`transition-delay: ${Math.min(i, 4) * 40}ms`}>
        <h2 class="display text-xl text-white mb-4 flex items-center gap-3">
          <span class="mono text-[#f45500] text-sm">{String(i + 1).padStart(2, '0')}</span>
          {s.h}
        </h2>
        {s.p.map((para) => (
          <p class="text-[#9d9d9d] leading-relaxed mb-3 text-[15px]">{para}</p>
        ))}
      </article>
    ))}
  </div>
</section>

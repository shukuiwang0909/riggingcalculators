---
import { getDict } from '../../i18n/ui';
import { p, TOOL_PATHS } from '../../i18n/paths';
import { WIRE_ROPES } from '../../data/rigging';
import type { Locale } from '../../config';
import ChartHead from '../ChartHead.astro';
import ToolShell from '../ToolShell.astro';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const t = getDict(lang);
const tp = t.chartPages.wire;

const constructions = [
  { key: '6x19' as const, name: '6×19 IWRC', desc: t.rope.c1d },
  { key: '6x36' as const, name: '6×36 IWRC', desc: t.rope.c2d },
  { key: '6x7' as const, name: '6×7 FC', desc: t.rope.c3d },
];
---

<ChartHead lang={lang} kicker={tp.kicker} title={tp.title} sub={tp.sub} note={tp.note} />

<section class="py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div class="grid lg:grid-cols-3 gap-6">
      {constructions.map((c, ci) => (
        <div class="panel overflow-hidden reveal" style={`transition-delay: ${ci * 60}ms`}>
          <div class="p-6 pb-4">
            <h2 class="mono text-lg font-bold text-[#f45500]">{c.name}</h2>
            <p class="text-xs text-[#5c5c5c] mt-2">{c.desc}</p>
          </div>
          <div class="overflow-x-auto">
            <table class="spec-table">
              <thead>
                <tr><th>{t.charts.thDia}</th><th>{t.charts.thBreak}</th><th>{t.charts.thKgm}</th></tr>
              </thead>
              <tbody>
                {WIRE_ROPES.filter((r) => r.construction === c.key).map((r) => (
                  <tr><td>{r.diameter_mm}</td><td>{r.breaking_load_tonnes.toFixed(1)}</td><td>{r.weight_kg_per_m.toFixed(2)}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      ))}
    </div>

    <div class="panel p-6 reveal no-print flex flex-wrap items-center justify-between gap-4">
      <p class="text-sm text-[#9d9d9d]">{t.rope.sub}</p>
      <a href={p(lang, TOOL_PATHS.rope)} class="btn-safety">{t.tools.rope.name} →</a>
    </div>
  </div>
</section>

<ToolShell lang={lang} section="faq" faqTitle={tp.faqTitle} faqItems={t.rope.faqItems} />
<ToolShell lang={lang} section="cta" />

---
interface Props { kicker: string; title: string; sub?: string; }
const { kicker, title, sub } = Astro.props;
---

<div class="mb-12 reveal">
  <div class="micro mb-3 flex items-center gap-3">
    <span class="text-[#f45500]">::</span> {kicker}
  </div>
  <h2 class="display text-3xl md:text-4xl text-white">{title}</h2>
  {sub && <p class="text-[#9d9d9d] mt-4 max-w-2xl leading-relaxed">{sub}</p>}
</div>
